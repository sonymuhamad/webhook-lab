# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries (built with `go test -c`)
*.test

# Output of the go coverage tool, test artifacts
*.out
*.coverprofile
coverage.txt
profile.cov

# Common build directories (if you output builds to a bin folder)
bin/
dist/

# Go workspaces
go.work
go.work.sum

# Dependency directories
# Un-comment the line below if you explicitly want to ignore the vendor directory.
# (Not recommended unless you rely strictly on go modules without vendoring)
# vendor/

# Environment variables / Local secrets
.env
.env.local

# IDE specific files (Optional but highly recommended)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude
# Lab API keys written by labs/*/setup.sh
.lab.env
