LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=10s
POSTGRES_URL=postgres://postgres@localhost:5432/webhook_lab?sslmode=disable
ADMIN_TOKEN=generate-with-openssl-rand-base64-32
# Leave an endpoint empty to turn that signal off.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:9090/api/v1/otlp/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs
OTEL_METRIC_EXPORT_INTERVAL=5000
WORKER_COUNT=1
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL=500ms
# naive exists only for lab 01; skiplocked is the real mode.
WORKER_CLAIM_MODE=skiplocked
WORKER_CLAIM_LEASE=2m
DELIVERY_TIMEOUT=10s
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_DELAY=30s
